# Smart Scheduler — Server Environment Variables
# Copy this file to .env and fill in the values

# MongoDB connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing secret — use a long, random string (required)
JWT_SECRET=replace-with-a-long-random-secret-string

# Server port (optional, defaults to 5000)
PORT=5000

# Path to your Google OAuth2 credentials JSON (optional)
# Defaults to ./credentials.json relative to the server directory
# GOOGLE_CREDENTIALS_PATH=./credentials.json

# ── Forgot Password Email (required for password reset) ──────────────────────
# Get a Gmail App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Frontend URL (used in reset email links)
# Local development:
CLIENT_URL=http://localhost:5173
# Production:
# CLIENT_URL=https://smart-scheduler1.netlify.app

